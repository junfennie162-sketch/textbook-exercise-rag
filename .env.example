# 复制为 backend/.env 后按需填写

# ==================== LLM：两种连接模型的方式（LLM_PROVIDER 一键切换） ====================
# cloud  = 云端 API（OpenAI 兼容端点，需联网与 API Key）
# ollama = 本地 Ollama 模型（零费用、断网可用；需先安装 Ollama 并拉取模型）
LLM_PROVIDER=cloud

# ---------- 方式一：云端 API（OpenAI 兼容端点，三选一） ----------
# 示例 A：commandcode 聚合服务（可用 deepseek 系列；模型名以 GET /models 返回为准）
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# 示例 B：DeepSeek 官方（platform.deepseek.com 申请 Key）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-你的DeepSeekKey
# LLM_MODEL=deepseek-chat
# 示例 C：智谱 GLM（open.bigmodel.cn 申请 Key）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的智谱Key
# LLM_MODEL=glm-4.6
# 提示：换服务商只改上面三行；模型名必须与端点实际可用模型一致；
#      推理型模型首字延迟 10~20 秒属正常，追求速度可换 fast 变体。

# ---------- 方式二：本地 Ollama（https://ollama.com 下载安装） ----------
# 先执行：ollama pull qwen2.5:3b（模型可按机器配置换成 7b 等）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=ollama        # Ollama 不校验 Key，占位即可

# 采样温度（生成确定性，法律/教学场景建议 0.3）
LLM_TEMPERATURE=0.3

# ---------- 离线模板模式（优先级最高，与上面两种互斥） ----------
# true  = 不调用任何大模型：用检索到的教材片段拼装五段式解析（零调用、零费用、可离线演示）
LLM_MOCK=false

# ==================== 检索 / RAG ====================
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.60
EVIDENCE_RELATIVE_CUT=0.85  # 来源相对筛选：低于「最高分×该值」的来源不进引用列表（1.0=关闭）

# 混合检索（加分项：BM25+向量混合召回、RRF 融合、轻量重排）
RETRIEVAL_MODE=hybrid      # hybrid=混合检索 | vector=纯向量（消融对照用）
RERANK_ENABLED=true        # 轻量重排开关
RECALL_MULTIPLIER=3        # 每路召回量 = TOP_K × 此倍数
RRF_K=60                   # RRF 倒数排名融合常数
RERANK_ALPHA=0.6           # 重排权重：α×余弦 + (1-α)×关键词覆盖度

# 上传限制（MB）
MAX_UPLOAD_MB=20

# 批量解析（并发度限流 + 规模上限）
BATCH_CONCURRENCY=3        # 并发路数；设为 1 即串行
BATCH_MAX_QUESTIONS=100    # 单次批量题目数上限
BATCH_MAX_JOBS=3           # 同时运行的批量任务数上限

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
