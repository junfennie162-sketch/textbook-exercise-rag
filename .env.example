# 复制为 backend/.env 后按需填写

# LLM（Anthropic 兼容端点，示例为智谱 GLM）
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_API_KEY=
LLM_MODEL=glm-4.6
# true = 离线模板模式：不调用大模型，用检索到的教材片段拼装解析（零调用、零费用、可离线演示）
# false = 调用真实大模型生成解析（需在上方填写 LLM_API_KEY）
LLM_MOCK=true

# 检索 / RAG
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.60

# 混合检索（加分项：BM25+向量混合召回、RRF 融合、轻量重排）
RETRIEVAL_MODE=hybrid      # hybrid=混合检索 | vector=纯向量（消融对照用）
RERANK_ENABLED=true        # 轻量重排开关
RECALL_MULTIPLIER=3        # 每路召回量 = TOP_K × 此倍数
RRF_K=60                   # RRF 倒数排名融合常数
RERANK_ALPHA=0.6           # 重排权重：α×余弦 + (1-α)×关键词覆盖度

# 上传限制（MB）
MAX_UPLOAD_MB=20

# 批量解析并发度（Semaphore 限流；设为 1 即退化为串行）
BATCH_CONCURRENCY=3

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 预留：切换 DeepSeek 时使用
DEEPSEEK_API_KEY=
